---
import { Image } from 'astro:assets';
import LatinRengoAnalytics from './LatinRengoAnalytics.astro';
import LatinRengoSocialLayout from '../layouts/LatinRengoSocialLayout.astro';
import {
	archivePath,
	formatCLP,
	latinRengoSocialEvent as event,
	menuPath,
	publicFaqItems,
	publicPresentationSchedule,
	publicSchedule,
	publicTickets,
} from '../content/social';

const pageTitle = 'LatinRengo Social 2026 | Edición anterior';
const pageDescription =
	'Registro de LatinRengo Social del 18 de julio de 2026: programa, artistas y guía de esa edición. El evento ya se realizó.';
---

<LatinRengoSocialLayout
	title={pageTitle}
	description={pageDescription}
	canonicalPath="/latin-rengo-social"
	noindex
>
	<LatinRengoAnalytics sourcePage="latin-rengo-social" />
	<main id="contenido" data-latin-rengo class="lr-page lr-guide">
		<p class="lr-past-event-notice">Esta edición se realizó el 18 de julio de 2026. El programa, los precios y el menú son un registro histórico; <a href="/sociales">consulta aquí por próximos sociales</a>.</p>
		<section class="lr-hero" aria-labelledby="lr-title">
			<div class="lr-hero__inner">
				<p class="lr-eyebrow">{event.edition}</p>
				<h1 id="lr-title">{event.shortName}</h1>
				<div class="lr-hero__facts" aria-label="Resumen del evento">
					<p>
						<time datetime="2026-07-18">{event.dateLabel}</time>
					</p>
					<p>{event.venueName}</p>
					<p>{event.quickSummary}</p>
				</div>
				<nav class="lr-quick-nav" aria-label="Accesos rápidos">
					<a
						href="#programa"
						data-lr-event="select_schedule"
						data-lr-site-section="quick_nav"
						data-lr-source-page="latin-rengo-social"
						data-lr-destination="schedule"
						data-lr-link-type="anchor"
					>
						Programación
					</a>
					<a href={menuPath}>Menú</a>
					<a href="#entradas">Entradas de 2026</a>
					<a href="#como-llegar">Cómo llegar</a>
					<a href="#contacto">Contacto</a>
				</nav>
			</div>
		</section>

		<section class="lr-section lr-section--tight" aria-labelledby="lr-access-title">
			<div class="lr-section__heading">
						<p class="lr-kicker">Registro de la edición 2026</p>
				<h2 id="lr-access-title">Accesos útiles</h2>
			</div>
			<div class="lr-action-grid">
				<a
					class="lr-action"
					href="#programa"
					data-lr-event="select_schedule"
					data-lr-site-section="access_grid"
					data-lr-source-page="latin-rengo-social"
					data-lr-destination="schedule"
					data-lr-link-type="anchor"
				>
					<span>Ver horarios</span>
						<small>Clase, social, presentaciones y cierre de 2026.</small>
				</a>
				<a class="lr-action" href={menuPath}>
					<span>Ver menú</span>
						<small>Menú de la edición de 2026.</small>
				</a>
				<a
					class="lr-action"
					href={event.contact.whatsappHref}
					data-lr-event="select_contact"
					data-lr-site-section="access_grid"
					data-lr-source-page="latin-rengo-social"
					data-lr-destination="whatsapp"
					data-lr-contact-method="whatsapp"
					data-lr-link-type="whatsapp"
				>
					<span>Consultar a LatinRengo</span>
					<small>{event.contact.label}</small>
				</a>
				<a class="lr-action" href="#como-llegar">
					<span>Cómo llegar</span>
						<small>Recinto de la edición de 2026.</small>
				</a>
			</div>
		</section>

		<section id="programa" class="lr-section" aria-labelledby="lr-schedule-title">
			<div class="lr-section__heading">
				<p class="lr-kicker">Programa público confirmado</p>
				<h2 id="lr-schedule-title">Cronograma</h2>
			</div>
			<div class="lr-program-block">
				<h3>Programa general</h3>
				<ol class="lr-timeline">
					{publicSchedule.map((item) => (
						<li>
							<time datetime={item.startDateTime}>{item.timeLabel}</time>
							<div>
								<h4>{item.title}</h4>
								{item.description && <p>{item.description}</p>}
							</div>
						</li>
					))}
				</ol>
			</div>

			<div class="lr-program-block lr-program-block--performances">
				<div class="lr-section__heading lr-section__heading--split">
					<div>
						<p class="lr-kicker">Bloque artístico</p>
						<h3>Orden de presentaciones</h3>
					</div>
					<p class="lr-note">Horario programado, sujeto a ajustes operativos.</p>
				</div>
				<ol class="lr-performance-list">
					{publicPresentationSchedule.map((item, index) => (
						<li class:list={['lr-performance-item', `lr-performance-item--${item.kind}`]}>
							<time datetime={item.startDateTime}>{item.timeLabel}</time>
							{item.artistNumber && <span class="lr-performance-number">{item.artistNumber}</span>}
							<div class="lr-performance-item__body">
								<h4>{item.title}</h4>
								{(item.discipline || item.role) && <p>{item.discipline ?? item.role}</p>}
							</div>
							{item.artist?.image && item.artist.alt && (
								<a
									class="lr-performance-item__image"
									href={item.artist.image.src}
									aria-label={`Ver afiche de ${item.title} en grande`}
									data-lr-event="view_artist_poster"
									data-lr-site-section="performance_schedule"
									data-lr-source-page="latin-rengo-social"
									data-lr-artist-slug={item.artist.id}
									data-lr-link-type="poster"
								>
									<Image
										src={item.artist.image}
										alt={item.artist.alt}
										widths={[180, 260, 420]}
										sizes="(min-width: 760px) 12rem, 13rem"
										loading={index < 2 ? 'eager' : 'lazy'}
										decoding="async"
									/>
								</a>
							)}
						</li>
					))}
				</ol>
			</div>
		</section>

		<section id="entradas" class="lr-section" aria-labelledby="lr-tickets-title">
			<div class="lr-section__heading">
				<p class="lr-kicker">Registro histórico</p>
				<h2 id="lr-tickets-title">Entradas de 2026</h2>
				<p>Estos valores correspondieron solo al evento del 18 de julio de 2026. No hay entradas vigentes para esa edición.</p>
			</div>
			<div class="lr-price-list">
				{publicTickets.map((ticket) => (
					<article class="lr-price-row">
						<div>
							<h3>{ticket.label}</h3>
						</div>
						<strong>{formatCLP(ticket.price)}</strong>
					</article>
				))}
			</div>
			<a class="lr-primary-cta" href="/sociales">Consultar próximos sociales</a>
		</section>

		<section id="como-llegar" class="lr-section" aria-labelledby="lr-place-title">
			<div class="lr-section__heading">
				<p class="lr-kicker">Lugar confirmado</p>
				<h2 id="lr-place-title">Cómo llegar</h2>
			</div>
			<div class="lr-location-panel">
				<div class="lr-info-panel">
					<p><strong>{event.venueName}</strong></p>
					{event.location.mapUrl && (
						<a
							class="lr-primary-cta"
							href={event.location.mapUrl}
							data-lr-event="select_map"
							data-lr-site-section="location"
							data-lr-source-page="latin-rengo-social"
							data-lr-destination="google_maps"
							data-lr-link-type="external"
						>
							Abrir en Google Maps
						</a>
					)}
				</div>
				{event.location.mapEmbedUrl && event.location.mapUrl && (
					<div class="lr-map-frame">
						<iframe
							title={`Mapa de Google Maps: ${event.venueName}`}
							src={event.location.mapEmbedUrl}
							width="900"
							height="520"
							loading="lazy"
							referrerpolicy="no-referrer-when-downgrade"
							allowfullscreen
							tabindex="-1"
							aria-hidden="true"
						></iframe>
						<a
							class="lr-map-frame__link"
							href={event.location.mapUrl}
							data-lr-event="select_map"
							data-lr-site-section="location"
							data-lr-source-page="latin-rengo-social"
							data-lr-destination="google_maps"
							data-lr-link-type="map_overlay"
						>
							<span>Abrir ruta en Google Maps</span>
						</a>
					</div>
				)}
			</div>
		</section>

		<section id="contacto" class="lr-section" aria-labelledby="lr-contact-title">
			<div class="lr-section__heading">
				<p class="lr-kicker">Contacto público</p>
				<h2 id="lr-contact-title">LatinRengo</h2>
			</div>
			<div class="lr-contact-panel">
				<p>{event.contact.label}</p>
				<div class="lr-contact-panel__actions">
					<a
						class="lr-primary-cta"
						href={event.contact.whatsappHref}
						data-lr-event="select_contact"
						data-lr-site-section="contact"
						data-lr-source-page="latin-rengo-social"
						data-lr-destination="whatsapp"
						data-lr-contact-method="whatsapp"
						data-lr-link-type="whatsapp"
					>
						Escribir a LatinRengo
					</a>
					<a
						class="lr-primary-cta lr-primary-cta--secondary"
						href={event.contact.telHref}
						data-lr-event="select_contact"
						data-lr-site-section="contact"
						data-lr-source-page="latin-rengo-social"
						data-lr-destination="phone"
						data-lr-contact-method="phone"
						data-lr-link-type="tel"
					>
						Llamar a LatinRengo
					</a>
				</div>
			</div>
		</section>

		<section class="lr-section" aria-labelledby="lr-faq-title">
			<div class="lr-section__heading">
				<p class="lr-kicker">Preguntas frecuentes</p>
				<h2 id="lr-faq-title">Información rápida</h2>
			</div>
			<div class="lr-faq-list">
				{publicFaqItems.map((item) => (
					<details>
						<summary>{item.question}</summary>
						<p>{item.answer}</p>
					</details>
				))}
			</div>
		</section>

		<section class="lr-section lr-section--relationship" aria-labelledby="lr-relation-title">
			<div class="lr-section__heading">
				<p class="lr-kicker">Relación con LatinRengo</p>
				<h2 id="lr-relation-title">Una comunidad, una noche especial</h2>
			</div>
			<p>
				Esta guía conserva la edición de aniversario de 2026. Para conocer los encuentros de baile
				de LatinRengo, visita la página de sociales.
			</p>
			<a
				href="/"
				data-lr-event="select_main_latinrengo"
				data-lr-site-section="relationship"
				data-lr-source-page="latin-rengo-social"
				data-lr-destination="latin_rengo"
				data-lr-link-type="internal"
			>
				Ir a clases LatinRengo
			</a>
		</section>
	</main>
	<footer data-latin-rengo class="lr-footer">
		<a
			href="/"
			data-lr-event="select_main_latinrengo"
			data-lr-site-section="footer"
			data-lr-source-page="latin-rengo-social"
			data-lr-destination="latin_rengo"
			data-lr-link-type="internal"
		>
			LatinRengo
		</a>
		<a href={menuPath}>Menú del evento</a>
		<a href={archivePath}>Ver archivo de LatinRengo Social</a>
		<a href="/sociales">Sociales de salsa y bachata</a>
	</footer>
</LatinRengoSocialLayout>
